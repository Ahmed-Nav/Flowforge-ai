datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  workflows Workflow[]
}

model Workflow {
  id          String   @id @default(uuid())
  name        String
  userId      String
  triggerType String   // e.g., "webhook"
  status      String   // "active" or "draft"
  isActive    Boolean  @default(true)
  
  definition  Json 
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  runs        WorkflowRun[]
  
  User        User     @relation(fields: [userId], references: [id])
}

model WorkflowRun {
  id          String   @id @default(uuid())
  workflowId  String
  status      String   // "PENDING", "COMPLETED", "FAILED"
  outputs     Json?    // Store the final results here
  triggerInput Json?
  
  createdAt   DateTime @default(now())
  completedAt DateTime?

  Workflow    Workflow @relation(fields: [workflowId], references: [id])
}

model Document {
  id        String   @id @default(uuid())
  content   String   // The text (e.g., "Ahmed likes Python")
  metadata  Json?    // { "source": "user_input", "date": "2026-01-29" }

  // The "Brain Fingerprint" (Vector)
  // We use 768 dimensions because that is what Gemini uses.
  embedding Unsupported("vector(768)")? 

  createdAt DateTime @default(now())
}