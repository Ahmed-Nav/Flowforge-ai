# ==============================================================================
# FLOWFORGE AI - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================================
# Copy this file to '.env' in your root or backend/frontend directories
# and replace the placeholder values with your actual credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION 
# -> Required if running the Next.js frontend locally.
# ------------------------------------------------------------------------------
# The URL where your backend API is accessible.
# Default for local development: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001


# ------------------------------------------------------------------------------
# 2. BACKEND: CORE INFRASTRUCTURE
# -> Required for the backend server to start.
# ------------------------------------------------------------------------------
# PostgreSQL Database Connection String (Prisma format)
# Example: postgresql://user:password@localhost:5432/flowforge?schema=public
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public

# Redis Connection URL (Used for BullMQ job queues)
# Example: redis://localhost:6379 
REDIS_URL=redis://localhost:6379

# Secret key used to sign and verify JSON Web Tokens (JWT) for user auth.
# Use a long, random string. You can generate one with: `openssl rand -base64 32`
JWT_SECRET=your_super_secret_jwt_string_here

# The port where the backend Node.js Express server will listen.
PORT=3001

# The URL of the compiler service (if running the Python engine locally)
COMPILER_URL=http://localhost:8001


# ------------------------------------------------------------------------------
# 3. BACKEND: EXTERNAL API INTEGRATIONS
# -> Required only if you use their respective nodes in a workflow.
# ------------------------------------------------------------------------------

# --- AI & LLM APIs ---
# Groq API Key for the "AI Logic" node text generation.
# Get it at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

#(USE GROQ OR GEMINI : GROQ has better limits, GEMINI has better performance)

# Google Gemini API Key for the "Save Memory" node (Vector Embeddings).
# Get it at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here


# --- Email Sending & Gmail Watcher ---
# Note: For Gmail, you must use an "App Password", NOT your regular password.
# Enable 2-Step Verification on your Google Account, then go to:
# https://myaccount.google.com/apppasswords
EMAIL_USER=your.email@gmail.com
EMAIL_PASS=your_16_character_app_password


# --- Notion Integration ---
# Used for the "Notion Page" node to append content to databases.
# 1. Go to https://www.notion.so/my-integrations to create an integration
# 2. Copy the "Internal Integration Secret"
# 3. Important: Go to your Notion Database -> ... (top right) -> Connections -> add the integration.
NOTION_API_KEY=secret_your_notion_integration_secret_here
