  "resolver.resolve.predict": {
    "traces": [],
    "train": [],
    "demos": [],
    "signature": {
      "instructions": "To provide a more accurate prediction of the edges and trigger id for a given set of nodes and conditions in the Predict module, please provide the following additional information: \n1) Nodes: A list of nodes with their respective types and configurations (e.g., id, type, data, position)\n2) Conditions: A list of conditions that should be taken into account for the prediction (e.g., 'webhook data is received', 'Notion database is accessible')\n3) The goal of the workflow (e.g., 'automate a workflow for customer support', 'analyze customer data')\n4) Any additional context or details about the workflow (e.g., 'this is a scheduled workflow', 'this workflow uses a specific AI model')\n\nThe proposed instruction aims to improve the accuracy of the Predict module by incorporating more relevant information about the nodes, conditions, and workflow goal. This will enable the module to provide more nuanced and context-specific predictions of the edges and trigger id.",
      "fields": [
        {
          "prefix": "Nodes:",
          "description": "${nodes}"
        },
        {
          "prefix": "Conditions:",
          "description": "${conditions}"
        },
        {
          "prefix": "Reasoning: Let's think step by step in order to",
          "description": "${reasoning}"
        },
        {
          "prefix": "Edges:",
          "description": "${edges}"
        },
        {
          "prefix": "Trigger Id:",
          "description": "${trigger_id}"
        }
      ]
    },
    "lm": null
  },
